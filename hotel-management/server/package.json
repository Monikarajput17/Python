{
  "name": "hotel-management-server",
  "version": "1.0.0",
  "description": "Hotel Management SaaS Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "ts-node src/database/migrations/index.ts",
    "db:seed": "ts-node src/database/seeds/index.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "pg": "^8.11.1",
    "typeorm": "^0.3.16",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "joi": "^17.11.0",
    "axios": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1502.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.1",
    "morgan": "^1.10.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.13.0",
    "razorpay": "^2.9.2",
    "stripe": "^14.8.0",
    "openai": "^4.26.0",
    "express-async-errors": "^3.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.11",
    "@types/morgan": "^1.9.9",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
